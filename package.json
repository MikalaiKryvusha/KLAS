{
  "name": "klas",
  "version": "1.0.0",
  "private": true,
  "description": "KLAS — self-hosted AI ecosystem: local LLM on gaming GPU, autonomous agents, web dashboard, offline knowledge base.",
  "repository": "https://github.com/MikalaiKryvusha/KLAS",
  "license": "MIT",
  "scripts": {
    "deploy": "node tools/deploy.mjs",
    "deploy:apply": "node tools/deploy.mjs --apply",
    "health": "powershell -File tools/health-check.ps1",
    "guard:dry-run": "node tools/dry-run-guard.mjs",
    "guard:anonymize": "node tools/anonymize.mjs --selftest",
    "guard:encoding": "node tools/encoding-guard.mjs",
    "owner:questions": "node tools/owner-questions.mjs",
    "review": "node tools/review.mjs",
    "review:list": "node tools/review.mjs list",
    "guard:reviews": "node tools/verify-owner-reviews.mjs",
    "kaif:version": "node .kaif/kaif-core.mjs version",
    "kaif:check": "node .kaif/kaif-core.mjs check",
    "kaif:update": "node .kaif/kaif-core.mjs update"
  },
  "devDependencies": {
    "marked": "^18.0.5",
    "playwright": "^1.61.1",
    "sherpa-onnx-node": "^1.13.4"
  }
}
