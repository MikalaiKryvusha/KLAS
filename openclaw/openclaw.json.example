{
  "models": {
    "providers": {
      "klas": {
        "baseUrl": "http://127.0.0.1:8080/v1",
        "apiKey": "sk-local-klas",
        "api": "openai-completions",
        "models": [
          {
            "id": "qwen3.6-35b-a3b",
            "name": "Qwen3.6-35B-A3B (KLAS llama-swap, ОСНОВНАЯ с 2026-07-17, инт. 006: цепочки OpenClaw 6/6 без флейков)",
            "contextWindow": 98304,
            "maxTokens": 8192,
            "input": ["text"],
            "compat": { "unsupportedToolSchemaKeywords": ["pattern", "maxLength", "minLength", "maxItems", "minItems"] }
          },
          {
            "id": "qwen3.6-35b-a3b-r",
            "name": "Qwen3.6-35B-A3B retry-alias (тот же инстанс llama-swap; fallback №1 = ретрай той же модели при 500 сервера)",
            "contextWindow": 98304,
            "maxTokens": 8192,
            "input": ["text"],
            "compat": { "unsupportedToolSchemaKeywords": ["pattern", "maxLength", "minLength", "maxItems", "minItems"] }
          },
          {
            "id": "qwen3.5-35b",
            "name": "Qwen3.5-35B-A3B (бывшая основная → fallback до обкатки 3.6, инт. 006 Q2; цепочки 5/6)",
            "contextWindow": 98304,
            "maxTokens": 8192,
            "input": ["text"],
            "compat": { "unsupportedToolSchemaKeywords": ["pattern", "maxLength", "minLength", "maxItems", "minItems"] }
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "klas/qwen3.6-35b-a3b",
        "fallbacks": ["klas/qwen3.6-35b-a3b-r", "klas/qwen3.5-35b"]
      },
      "skills": ["healthcheck", "skill-creator"]
    }
  },
  "tools": {
    "exec": {
      "security": "allowlist",
      "ask": "off"
    }
  },
  "messages": {
    "tts": {
      "enabled": true,
      "auto": "off",
      "provider": "tts-local-cli",
      "providers": {
        "tts-local-cli": {
          "command": "node",
          "args": ["F:\\KLAS\\tools\\voice-say.mjs", "{{Text}}", "--out", "{{OutputPath}}"],
          "outputFormat": "wav",
          "timeoutMs": 120000
        }
      }
    }
  },
  "gateway": {
    "mode": "local",
    "bind": "tailnet",
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": "ВСТАВЬ_СЛУЧАЙНЫЙ_ТОКЕН_64_HEX (реальный — в caddy/PASSWORD.local.txt, вне git)"
    },
    "controlUi": {
      "enabled": true
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  }
}
