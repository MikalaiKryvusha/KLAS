# Тяжёлые/генерируемые артефакты — в git не попадают (репозиторий для документов, конфигов, скриптов)
*.gguf
node_modules/
*.log
logs/
# Кеш байткода Python — появляется рядом с сайдкарами tools/voice/ при их импорте друг из друга
__pycache__/
*.pyc

# Инфраструктура рядом с каркасом (идея 03: git = обёртка/фрейм; тяжёлое скачивает deploy).
# Версионируем только текстовые конфиги: профили запуска llamacpp\bat и Caddyfile.
/llamacpp/*
!/llamacpp/bat/
# Альтернативные сборки движка рядом с рабочей (точка отката + стенд для бисекции билдов, bugs/05).
# Только бинари — в git не попадают НИКОГДА; какая сборка в бою, фиксирует AGENT_GUIDE.
/llamacpp-b*/
/LLMs/
# Обе раскладки регистра: фактическая папка — KiwixDB (docker-compose), правило было /kiwixdb/ и
# держалось только на core.ignorecase Windows; на case-sensitive FS (WSL!) .zim-гигабайты стали бы
# untracked и уехали бы через git add -A (ревизия 2026-07-31)
/kiwixdb/
/KiwixDB/
# Кеш скачанных deploy'ем архивов движка (~150+ МБ zip'ов) — вне git (ревизия 2026-07-31)
/.deploy-cache/
/homepage/*
!/homepage/config/
/homepage/config/*
!/homepage/config/*.yaml
/AnythingLLM/
# Open WebUI: runtime-данные (data/) вне git; версионируем только свои тулы (open-webui/tools/)
/open-webui/*
!/open-webui/tools/
# Caddyfile содержит хеш пароля — в git только шаблон Caddyfile.example (инцидент 2026-07-03)
/caddy/*
!/caddy/Caddyfile.example
/mcp/
/nssm/

# Исходники логотипа тяжёлые — в git только готовые (KLAS.jpg подключён в README)
/logo/KLAS.psd
/logo/KLAS_ORIGIN_2x.png

# ── KAIF — вспомогательный dev-фреймворк, 3rd-party (идея 07) ─────────────────
# KLAS и KAIF — ДВЕ НЕЗАВИСИМЫЕ СУЩНОСТИ. KAIF развёрнут здесь ЛОКАЛЬНО в помощь разработке KLAS,
# но в репозиторий KLAS не упаковывается (как любая 3rd-party библиотека — ссылаемся и разворачиваем
# локально, см. tools/deploy.mjs). Файлы KAIF физически остаются на диске, но вне git-трекинга.
/.kaif/
/.claude/
/.roo/
KAIF_FRAMEWORK.md
AGENT_GUIDE.md
PHILOSOPHY.md
BUG_FIXING_FRAMEWORK.md
AGENTS.md
CLAUDE.md
/tools/kaif.mjs
KAIF.md
kaif-unpack.mjs
# ── добавлено при обновлении KAIF 1.2 → 1.6 (2026-07-26) ──────────────────────
# 1.6 раскладывает скиллы сразу под ПЯТЬ агентских систем (решение владельца) — копии канона
# .claude/skills/, их раскладывает машинерия, руками они не правятся:
/.agents/
/.grok/
/.cline/
/.clinerules/
# Новые ключевые документы фреймворка (появились в 1.4/1.5):
EXPERIENCE.md
TESTING_FRAMEWORK.md
# Транзиентные файлы установщика/обновления KAIF (их удаляет verify-final / update-verify сам,
# но пока они лежат — в git им не место):
KAIF-LOADER.mjs
KAIF_UPDATE_TASK.md
KAIF_ADAPTATION_TASK.md
# Инструмент обслуживания обёртки KAIF (наш, но живёт по правилам KAIF — вне трекинга, как tools/kaif.mjs):
/tools/kaif-baseline-diff.mjs

# Ярлык запуска KLAS (генерируется tools/install-klas-shortcut.ps1; машинно-зависимые абс. пути)
/KLAS.lnk

# Состояние мастера-установщика (прогресс/ответы конкретной машины) — не версионируем (план 05)
/.deploy-state.json
# JPG-рендеры PDF (tools/pdf-to-jpg.ps1) — локальные картинки для шаринга, вне git
/pdf2jpg/
# Личная карта ссылок + ключей владельца (реальный funnel-хост, логин, пароль, Bearer-ключ) —
# в git только шаблон LINKS.md. Документ ключей и его PDF-рендер НЕ версионируются.
/LINKS.local.*
# страховка: любые *.local.pdf и временные html рендерера — мимо git
*.local.pdf
*.tmp.html
# Сертификаты/ключи Tailscale (`tailscale cert` пишет *.ts.net.crt/.key) — приватный ключ НИКОГДА
# в git. Инцидент 2026-07-18: слабый агент положил в корень krinikspc.forest-ratio.ts.net.key.
*.ts.net.crt
*.ts.net.key
# Общее правило на ключи ЛЮБОГО происхождения: маски выше ловили только tailscale-суффикс,
# а следующий ключ пришёл бы с другим именем (ревизия 2026-07-31)
*.key
*.pem
id_rsa*

# Мусор ОС/редакторов
Thumbs.db
Desktop.ini
.DS_Store

# Голосовой тракт (Г1+, plans/11): venv, веса моделей, артефакты синтеза — вне git.
# ⚠️ Якорь `/` обязателен: без него правило скрывало и ИСХОДНИКИ `tools/voice/` (сайдкары TTS).
# Поймано 2026-07-28 — новые файлы резидентного рта молча не попадали в git.
/voice/

# Исходники голоса (записи дикторов) — сотни мегабайт и чужие авторские права: в git НИКОГДА.
# Повод: 2026-07-29 владелец сам скачал 170-мегабайтную начитку Вихрова и положил её в КОРЕНЬ
# репозитория; `git status` показал её как untracked, то есть очередной `git add -A` утащил бы
# её в историю. Правило канона «сначала ignore, потом инструмент» — вот ровно этот случай.
# ⚠️ Клон голоса реального актёра — только личное использование владельца (интервью 004 Q3),
# в поставку KLAS такие материалы и производные веса не кладутся.
/*.mp3
/*.wav
/*.m4a
/*.flac
# Кеши формы волны редакторов (Adobe Audition/Sound Forge пишут .sfk рядом с исходником).
# Повод: 2026-07-30 один такой файл проскочил в коммит через `git add -A` — правило `/*.mp3`
# ловило звук, но не служебный кеш РЯДОМ с ним. Правило «сначала ignore, потом инструмент»
# работает только если ignore покрывает и ПОБОЧНЫЕ файлы инструмента, а не один формат.
/*.sfk
/*.peak
/*.asd

# Запись экрана (tools/screen-rec.mjs) — «зрение» агента: кадры рабочего стола владельца.
# МОГУТ содержать что угодно (переписку, пароли на экране, личное) — в git НИКОГДА.
/screenrec/
# Стенд бисекции движка (tools/llamacpp-probe.mjs): распакованные билды llama.cpp, ~150 МБ каждый
/llamacpp-probe/
.kaif/install/
KAIF_UPDATE_TASK.superseded.md
.kaif/heartbeat.log

# помощник AEC собирается из исходника (tools/voice/aec-capture/build.ps1) — бинарник в git не нужен
tools/voice/aec-capture/*.exe
tools/voice/aec-capture/*.obj
